{
  "name": "opd-saathi",
  "private": true,
  "version": "1.0.0",
  "description": "OPD Saathi - smart queue and accessible navigation for government hospitals (hackathon prototype)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,app -c blue,green \"npm:dev:server\" \"npm:dev:app\"",
    "dev:app": "vite --host",
    "dev:server": "node --watch server/index.js",
    "dev:local": "vite --host",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.49.1",
    "postcss": "^8.4.49",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
